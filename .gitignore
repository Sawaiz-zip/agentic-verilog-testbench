# Environment
.env
__pycache__/
*.py[cod]
*.pyo
.venv/
.uv/

# Results. The per-run JSON records are large and stay local; the human-readable
# views and aggregates are published so the report's numbers can be checked.
# (Exclude contents, re-admit directories, then re-admit named files — git will
# not descend into an excluded directory, so a bare `results/` blocks the rest.)
results/*
!results/.gitkeep
!results/RESULTS.md
!results/*/
results/*/*
!results/*/REPORT.md
!results/*/summary.json
# Scratch output from scripts/show_run.py — regenerate it, don't commit it.
results/inspect/

# Data (download separately)
data/verilog_eval/
!data/verilog_eval/.gitkeep

# Build
dist/
*.egg-info/
.hatch/

# IDE
.vscode/
.idea/
*.swp

# macOS
.DS_Store

# Spec-kit agent context (may contain local paths / tokens)
.claude/

# Supervisor- and meeting-facing notes stay local; the rest of docs/ is published.
docs/meeting_prep.md
docs/supervisor_update.md
docs/archive/
docs/studio_input.json
docs/Screenshot*.png

# Correspondence and personal contact details — never publish.
supervisor_email.md

# Report source and learning notes — kept local, not published to the remote.
# The built PDF (report.pdf) and its LaTeX by-products were already untracked.
report.tex
docs/learn/
